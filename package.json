{
  "name": "cardpost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/db-env.mjs prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/db-env.mjs prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:studio": "node scripts/db-env.mjs prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "6.27.0",
    "server-only": "^0.0.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
