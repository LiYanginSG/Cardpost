# --- Database: Supabase Postgres ---
# If you connected Supabase to Vercel through the integration, you can leave these two unset: the app and the
# build read POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING, which the integration provides.
# Otherwise copy them from Project settings → Database → Connection string:
# Transaction pooler (port 6543) for the app. Keep pgbouncer=true so Prisma skips prepared statements.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler or direct connection (port 5432) for migrations.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Storage for uploaded postcard and stamp artwork (Project settings → API) ---
# The Vercel integration sets SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY for you.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""            # server-only; never expose to the browser
SUPABASE_ARTWORK_BUCKET="artwork"        # created automatically as a public bucket on first upload

# --- Who may manage the catalogue at /admin (comma-separated emails) ---
ADMIN_EMAILS="you@example.com"

# --- App ---
APP_URL="https://your-app.vercel.app"      # used in magic-link and arrival emails
AUTH_SECRET="change-me-32-random-chars"     # signs nothing yet, reserved; keep set
CRON_SECRET="change-me"                     # Vercel sets Authorization: Bearer <CRON_SECRET> on cron calls

# --- Email (Resend). If unset, magic links are printed to the server log and shown on-screen in dev. ---
RESEND_API_KEY=""
EMAIL_FROM="Cardpost <post@yourdomain.com>"

# --- Moderation for wandering cards (OpenAI moderation endpoint). If unset, a small word list is used. ---
OPENAI_API_KEY=""

# --- Phone verification (Twilio Verify). If unset, verification is a dev toggle. ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Payments (Stripe Checkout). If unset, postage books show as coming soon. ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Dev conveniences (never set in production) ---
DEV_TIME_TRAVEL="1"   # shows a clock control that shifts "now" so you can watch cards arrive
DEMO_BOTS="1"         # seeded demo holders sign and pass wandering cards on, so the wall moves before you have users
